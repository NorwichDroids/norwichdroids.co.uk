{
  "name": "norwich-droids",
  // Set this to today's date the first time you deploy, then leave it alone.
  "compatibility_date": "2026-08-28",
  "main": "src/index.js",

  // Static pages (Home, About, Events, Gallery, CSS, images) — served directly,
  // Worker code below only runs for URLs that don't match a file in here
  // (i.e. everything under /members/...).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Members-area storage: RSVPs, added droids, and login sessions.
  // This id was created for you already — leave it as-is.
  "kv_namespaces": [
    { "binding": "DATA", "id": "f33939aa720842c49799c06f9244fbbd" }
  ]

  // NOTE: this site uses individual member logins (not a shared password),
  // so there's nothing to configure here for that — see README.txt section
  // 3 for the one-time step to create the first admin.
  //
  // There IS one optional secret you can add, but never here in
  // wrangler.jsonc (secrets never belong in a file that ends up in
  // GitHub) — RESEND_API_KEY, which turns on emailing members whenever an
  // event is added/updated. See README.txt section 3B. Skip it entirely
  // if you don't want that; everything else works fine without it.
}
