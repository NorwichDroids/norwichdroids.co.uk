{
  "name": "norwich-droids",
  // Set this to today's date the first time you deploy, then leave it alone.
  "compatibility_date": "2026-08-28",
  "main": "src/index.js",

  // Static pages (Home, About, Events, Gallery, CSS, images) — served directly,
  // Worker code below only runs for URLs that don't match a file in here
  // (i.e. everything under /members/...).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Members-area storage: RSVPs, added droids, and login sessions.
  // This id was created for you already — leave it as-is.
  "kv_namespaces": [
    { "binding": "DATA", "id": "f33939aa720842c49799c06f9244fbbd" }
  ]

  // NOTE: the shared members password is NOT set here (never put secrets in
  // this file). Set it as a secret named MEMBERS_PASSWORD — see README.txt.
}
